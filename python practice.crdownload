a=10,20,30
print(type(a))

a=10,
print(type(a))

a=[10]
print(type(a))
#empty list
a=[]
print(type(a))
#multiple values
a=[10,20,30]
print(type(a))

a=list((10,20,30))
print(type(a))

#tuple
a=(10,20,20,39)
print(type(a))

b=()
print(type(b))
b=tuple([10,20,30])
print(type(b))

#set
c={10,20,30,40}
print(type(c))

c=set()
print(type(c))

#dictionary

d={"name":"rithika","age":17,"group":"ece"}
print(type(d))

#lists mutable
data=["rithika",1,2,"chocolate"]
print(data)
data.append(11)
print(data)

#immutable strings
s="chocolate"
print(s)
print(s.capitalize())


b=["rithika",1,2,"chocolate"]
print(type(b))

b=("rithika",1,2,"chocolate")
print(type(b))

b={"name":"rithika","college":"IIT","age":17}
print(type(b))

#append
s=["rithika","sanjai","amirtha","Rithika",9.9]
print(s)
s.append(100)
print(s)
print("index",s)
#s.clear()
print(s)
b=s.copy()
print("copy list",b)
print(s.count("rithika"))
a=[1,2,3,4]
s.append(a)
print(s)
print(s.index("sanjai"))
s.insert(3,"megha")
print(s)
#remove last element
s.pop()
print(s)
#last in first out
s.remove("amirtha")
print(s)
s.reverse()
print(s)
b=[20,68,25,45,70]
b.sort()
print(b)


